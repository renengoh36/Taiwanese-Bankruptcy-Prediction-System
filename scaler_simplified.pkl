   ],
   "source": [
    "from sklearn.metrics import classification_report, confusion_matrix, roc_auc_score\n",
    "\n",
    "# Predictions\n",
    "y_test_pred_prob = ann_model.predict(X_test_scaled)\n",
    "y_test_pred = (y_test_pred_prob > 0.5).astype(int)\n",
    "\n",
    "print(\"Classification Report (Test):\")\n",
    "print(classification_report(y_test, y_test_pred, target_names=['Not Bankrupt', 'Bankrupt']))\n",
    "\n",
    "print(\"AUC Score:\", roc_auc_score(y_test, y_test_pred_prob))\n"
   ]
  },
