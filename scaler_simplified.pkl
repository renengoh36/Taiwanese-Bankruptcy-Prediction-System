   ],
   "source": [
    "##### import numpy as np\n",
    "import pickle\n",
    "import pandas as pd\n",
    "from tensorflow.keras.models import load_model\n",
    "\n",
    "# Load model & scaler\n",
    "ann_model = load_model(\"ann_model_simplified.h5\")\n",
    "with open(\"scaler_simplified.pkl\", \"rb\") as f:\n",
    "    scaler = pickle.load(f)\n",
    "\n",
    "print(\"\\n=== Bankruptcy Prediction Prototype (ANN) ===\\n\")\n",
    "print(\"Please enter the company's financial ratios:\\n\")\n",
    "\n",
    "# Collect inputs\n",
    "debt_ratio = float(input(\"Debt Ratio: \"))\n",
    "current_ratio = float(input(\"Current Ratio: \"))\n",
    "quick_ratio = float(input(\"Quick Ratio: \"))\n",
    "operating_profit_rate = float(input(\"Operating Profit Rate: \"))\n",
    "tax_rate = float(input(\"After-tax net Interest Rate: \"))\n",
    "income_assets = float(input(\"Return on Assets (ROA): \"))\n",
    "income_equity = float(input(\"Return on Equity (ROE): \"))\n",
    "\n",
    "# Build input\n",
    "sample = [[debt_ratio, current_ratio, quick_ratio,\n",
    "           operating_profit_rate, tax_rate, income_assets, income_equity]]\n",
    "\n",
    "sample_df = pd.DataFrame(sample, columns=[\n",
    "    'Debt ratio %',\n",
    "    'Current Ratio',\n",
    "    'Quick Ratio',\n",
    "    'Operating Profit Rate',\n",
    "    'After-tax net Interest Rate',\n",
    "    'Net Income to Total Assets',\n",
    "    \"Net Income to Stockholder's Equity\"\n",
    "])\n",
    "\n",
    "sample_scaled = scaler.transform(sample_df)\n",
    "\n",
    "# Predict bankruptcy with ANN\n",
    "prediction_prob = ann_model.predict(sample_scaled)[0][0]\n",
    "\n",
    "# Calculate probabilities\n",
    "prob_not_bankrupt = 1 - prediction_prob\n",
    "prob_bankrupt = prediction_prob\n",
    "\n",
    "# Decision (threshold = 0.5)\n",
    "prediction = 1 if prediction_prob > 0.5 else 0\n",
    "\n",
    "print(\"\\n=== Prediction Result ===\\n\")\n",
    "print(f\"Probability of NOT Bankrupt: {prob_not_bankrupt*100:.2f}%\")\n",
    "print(f\"Probability of Bankrupt: {prob_bankrupt*100:.2f}%\")\n",
    "\n",
    "if prediction == 1:\n",
    "    print(\"\\n⚠️ Company at RISK of Bankruptcy\")\n",
    "else:\n",
    "    print(\"\\n✅ Company is NOT Bankrupt\")\n",
    "    \n"
   ]
  },
